# Copy to .env.local (never commit .env.local) and fill in the values on the SERVER only.
# Secrets must never be prefixed with NEXT_PUBLIC_. See docs/SETUP-GUIDE.md for every step.

# ---------- Site address (SEO) ----------
# The public address of the live site, e.g. https://www.yourdomain.example (no trailing path).
# Used for canonical links, social previews, sitemap.xml and robots.txt. Public, not secret.
# Until it is set the site tells search engines NOT to index it (safe for previews).
# It is baked in at build time: set it, then redeploy.
NEXT_PUBLIC_SITE_URL=

# ---------- Email (Resend) ----------
# Resend API key (https://resend.com/api-keys). Required to send enquiry emails.
RESEND_API_KEY=

# Sender shown on notification emails. Must be an address on a domain you have verified in Resend,
# for example: Nature View Resort <enquiries@yourdomain.example>. There is no default.
# A Gmail address cannot be used as the sender here.
ENQUIRY_FROM_EMAIL=

# Where enquiries are delivered. Optional; defaults to natureviewresort1@gmail.com.
ENQUIRY_TO_EMAIL=

# ---------- Database (PostgreSQL) ----------
# Connection string from Neon (recommended), Supabase or any PostgreSQL, e.g.
# postgresql://user:password@host/dbname?sslmode=require
# Without it the site still works but enquiries are NOT stored. Run `npm run db:migrate` once after setting it.
DATABASE_URL=

# ---------- Limits (optional; defaults shown) ----------
# Server-side abuse controls.
# ENQUIRY_RATE_LIMIT_MAX=6
# ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=10
# ENQUIRY_DUPLICATE_WINDOW_MINUTES=30
#
# Form limits. These are public (NEXT_PUBLIC_) so the browser form matches the server; changing them needs a rebuild.
# They are technical sanity limits, not resort policy.
# NEXT_PUBLIC_ENQUIRY_MAX_ADULTS=20
# NEXT_PUBLIC_ENQUIRY_MAX_CHILDREN=20
# NEXT_PUBLIC_ENQUIRY_MAX_TOTAL_GUESTS=30
# NEXT_PUBLIC_ENQUIRY_MAX_NIGHTS=90
# NEXT_PUBLIC_ENQUIRY_MAX_DAYS_AHEAD=730
# NEXT_PUBLIC_ENQUIRY_MAX_EVENT_GUESTS=5000

# ---------- Testing only ----------
# Send to a local mock server instead of Resend. Leave empty in production.
RESEND_API_URL=
